# DeepSeek（默认 provider）
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 阿里云百炼 / DashScope（qwen provider）
DASHSCOPE_API_KEY=your-dashscope-api-key

# 可选：其他模型（如需）
# GOOGLE_API_KEY=your-key
# ANTHROPIC_API_KEY=your-key

# ---- 平台信息（config.yaml 的 ${VAR} 占位符从这里注入）----
# 每新增一个平台，就在 config.yaml 的 platforms 段加一项，并在此补对应变量。
# 账号密码按平台前缀命名：<平台大写>_ACCOUNT / <平台大写>_PASSWORD，
# 用例里用通用占位符 ${ACCOUNT} / ${PASSWORD}，运行时按平台自动注入。
MANHATTAN_HOST=your-platform.example.com
MANHATTAN_LOGIN_URL=https://your-platform.example.com/Login
MANHATTAN_ACCOUNT=your-account
MANHATTAN_PASSWORD=your-password

# 第二个平台示例（业主管理平台）：
# OWNER_HOST=your-owner.example.com
# OWNER_LOGIN_URL=https://your-owner.example.com/Login
# OWNER_ACCOUNT=your-owner-account
# OWNER_PASSWORD=your-owner-password

# 加盟商/业主平台（uat2-ev-franchisee）
FRANCHISEE_HOST=your-platform.example.com
FRANCHISEE_LOGIN_URL=https://your-platform.example.com/Home
FRANCHISEE_ACCOUNT=your-account
FRANCHISEE_PASSWORD=your-password
